#define OSByte_SelectPointerShape 0x6A


static gcontext_t *gc;

#define FONT_SIZE (12.0)

#define X(_p) ((int)( ((_p) * (screen.height - 4) / screenHeight) ))
#define Y(_p) ((int)( screen.height - 4 - ((_p) * (screen.height - 4) / screenHeight) ))
#define W(_p) ((int)( ((_p) * (screen.height - 4) / screenHeight) ))
#define H(_p) ((int)( ((_p) * (screen.height - 4) / screenHeight) ))
#define IX(_p) ((int)( ((_p) * screenHeight / (screen.height - 4)) ))
#define IY(_p) ((int)( ((screen.height - 4 - (_p)) * screenHeight / (screen.height - 4)) ))
#define IW(_p) ((int)( ((_p) * screenHeight / (screen.height - 4)) ))
#define IH(_p) ((int)( ((_p) * screenHeight / (screen.height - 4)) ))

#define FONT_NAME "Homerton.Medium"

#ifdef PORTRAIT
#define screenWidth ((21.0 / 2.54) * 72)
#define screenHeight ((29.7 / 2.54) * 72)
#else
#define screenWidth ((29.7 / 2.54) * 72)
#define screenHeight ((21.0 / 2.54) * 72)
#endif
bounds_t screen;

int bank = 1;

void r_init(void) {
#ifdef __riscos
    gc = gcontext_initvdu(1);
    if (gc == NULL)
        abort();

    {
        int32_t mode_selector[] = {
            1, /* Flags */
#ifdef PORTRAIT
            800,
            1024,
#else
            #if 0
            1024,
            768, /* Was 800, but that doesn't start in RPCEmu */
            #else
            800, 600,
            #endif
#endif
            4,
            -1,
            -1,
        };
        _kernel_oserror * err = _swix(OS_ScreenMode, _INR(0, 1), 0, &mode_selector);
        if (err)
        {
            dprintf("Couldn't change mode: %s\n", err->errmess);
            abort();
        }
    }
    screen_get_size(&screen);

    /* Pointer on */
    _swix(OS_Byte, _INR(0, 2), OSByte_SelectPointerShape, 1, 0);
    _swix(OS_Byte, _INR(0, 1), 112, bank);
    bank = 3-bank;
    _swix(OS_Byte, _INR(0, 1), 113, bank);
#endif
}


void r_riscos_to_ui(int x, int y, mu_Vec2 *vec)
{
    vec->x = IX(x);
    vec->y = IY(y);
}


void r_draw_rect(mu_Rect rect, mu_Color color) {
    dprintf("r_draw_rect(%i,%i + %i,%i, R%i, G%i, B%i)\n", rect.x, rect.y, rect.w, rect.h, color.r, color.g, color.b);
    gc->rectangle_fill(gc, COLOUR_RGB(color.r, color.g, color.b),
                       X(rect.x), Y(rect.y),
                       X(rect.x + rect.w) - 1,
                       Y(rect.y + rect.h) - 1);
}


void r_draw_text(const char *text, mu_Vec2 pos, mu_Color color) {
    int32_t xsize = W(FONT_SIZE / 2.5 * 16);
    int32_t ysize = H(FONT_SIZE / 2.5 * 16);
    font_t font;
    static int32_t height = -1;
    if (height == -1)
        height = r_get_text_baseline();

    dprintf("r_draw_text('%s', %i, %i, R%i, G%i, B%i)\n", text, pos.x, pos.y, color.r, color.g, color.b);

    font = gc->text_findfont(gc, FONT_NAME, xsize, ysize);
    gc->text_paint(gc, font, X(pos.x), Y(pos.y + height),
               0, COLOUR_RGB(color.r, color.g, color.b),
               text,
               -1);
    gc->text_losefont(gc, font);

#ifdef DEBUG_TEXT_RECTANGLE
    {
        mu_Rect rect;
        rect.x = pos.x;
        rect.y = pos.y;
        rect.w = r_get_text_width(text, strlen(text));
        rect.h = r_get_text_height();

        gc->rectangle_outline(gc, COLOUR_RGB(color.r, color.g, color.b),
                              X(rect.x), Y(rect.y) -1,
                              X(rect.x + rect.w) - 1,
                              Y(rect.y + rect.h));
    }
#endif
}


void r_draw_icon(int id, mu_Rect rect, mu_Color color) {
    dprintf("r_draw_icon(%i, %i,%i + %i,%i, R%i, G%i, B%i)\n", id, rect.x, rect.y, rect.w, rect.h, color.r, color.g, color.b);

    switch (id)
    {
        case MU_ICON_CLOSE:
            {
                uint32_t colour_x;
#ifdef BORDER_CLOSE
                gc->rectangle_fill(gc, COLOUR_RGB(color.r, color.g, color.b),
                                   X(rect.x), Y(rect.y),
                                   X(rect.x + rect.w),
                                   Y(rect.y + rect.h));

                border_drawsimple(gc, bt_outset,
                                  2,
                                  X(rect.x), Y(rect.y),
                                  W(rect.w), H(rect.h),
                                  COLOUR_RGB(color.r, color.g, color.b),
                                  COLOUR_NONE);
                colour_x = COLOUR_RGB(255 - color.r, 255 - color.g, 255 - color.b);
#else
                colour_x = COLOUR_RGB(color.r, color.g, color.b);
#endif

#define INSET_X (12)
                gc->line_start(gc, colour_x);
                gc->line_line(gc, X(rect.x) + INSET_X, Y(rect.y) - INSET_X,
                                  X(rect.x + rect.w) - INSET_X, Y(rect.y + rect.h) + INSET_X);
                gc->line_end(gc);

                gc->line_start(gc, colour_x);
                gc->line_line(gc, X(rect.x) + INSET_X, Y(rect.y + rect.h) + INSET_X,
                                  X(rect.x + rect.w) - INSET_X, Y(rect.y) - INSET_X);
                gc->line_end(gc);
            }
            break;

        case MU_ICON_CHECK:
            {
#define INSET_CHECK (12)
                gc->rectangle_fill(gc, COLOUR_RGB(color.r, color.g, color.b),
                                   X(rect.x) + INSET_CHECK, Y(rect.y) - INSET_CHECK,
                                   X(rect.x + rect.w) - INSET_CHECK,
                                   Y(rect.y + rect.h) + INSET_CHECK);
            }
            break;

        case MU_ICON_EXPANDED:
            {
#define INSET_EXPAND (12)
                /* Expanded usually drawn as 'v' marker */
                bbox_t box;
                int cx = X(rect.x + rect.w / 2);
                int cy = Y(rect.y + rect.w / 2);
                int w = W(rect.w) - INSET_EXPAND * 2;
                int h = H(rect.h) - INSET_EXPAND * 2;

                box.x0 = X(rect.x) + INSET_EXPAND;
                box.y1 = Y(rect.y) - INSET_EXPAND;
                box.x1 = X(rect.x + rect.w) - INSET_EXPAND;
                box.y0 = Y(rect.y + rect.h) + INSET_EXPAND;


                gc->line_start(gc, COLOUR_RGB(color.r, color.g, color.b));
                gc->line_line(gc,
                              box.x0, cy + h / 4,
                              cx,     cy - h / 4);
                gc->line_line(gc,
                              cx,     cy - h / 4,
                              box.x1, cy + h / 4);
                gc->line_end(gc);
            }
            break;

        case MU_ICON_COLLAPSED:
            {
#define INSET_EXPAND (12)
                /* Collapsed usually drawn as 'v' marker */
                bbox_t box;
                int cx = X(rect.x + rect.w / 2);
                int cy = Y(rect.y + rect.w / 2);
                int w = W(rect.w) - INSET_EXPAND * 2;
                int h = H(rect.h) - INSET_EXPAND * 2;

                box.x0 = X(rect.x) + INSET_EXPAND;
                box.y1 = Y(rect.y) - INSET_EXPAND;
                box.x1 = X(rect.x + rect.w) - INSET_EXPAND;
                box.y0 = Y(rect.y + rect.h) + INSET_EXPAND;


                gc->line_start(gc, COLOUR_RGB(color.r, color.g, color.b));
                gc->line_line(gc,
                              cx - w / 4, box.y1,
                              cx + w / 4, cy);
                gc->line_line(gc,
                              cx + w / 4, cy,
                              cx - w / 4, box.y0);
                gc->line_end(gc);
            }
            break;

        default:
            gc->rectangle_fill(gc, COLOUR_RGB(color.r, color.g, color.b),
                               X(rect.x), Y(rect.y),
                               X(rect.x + rect.w),
                               Y(rect.y + rect.h));
            break;
    }
}


int r_get_text_width(const char *text, int len) {
    int32_t xsize = W(FONT_SIZE / 2.5 * 16);
    int32_t ysize = H(FONT_SIZE / 2.5 * 16);
    stringbounds_t bounds = {0};

    font_t font = gc->text_findfont(gc, FONT_NAME, xsize, ysize);
    gc->text_getstringsize(gc, font, &bounds, -1, text, len, 0);
    gc->text_losefont(gc, font);

    return IW(bounds.xoffset);
}


int r_get_text_height(void) {
    int32_t xsize = W(FONT_SIZE / 2.5 * 16);
    int32_t ysize = H(FONT_SIZE / 2.5 * 16);
    stringbounds_t bounds = {0};

    font_t font = gc->text_findfont(gc, FONT_NAME, xsize, ysize);
    gc->text_getstringsize(gc, font, &bounds, -1, "@jtLm,!'^", -1, 0);
    gc->text_losefont(gc, font);

    return IH(bounds.ascent + bounds.descent);
}

int r_get_text_baseline(void) {
    int32_t xsize = W(FONT_SIZE / 2.5 * 16);
    int32_t ysize = H(FONT_SIZE / 2.5 * 16);
    stringbounds_t bounds = {0};

    font_t font = gc->text_findfont(gc, FONT_NAME, xsize, ysize);
    gc->text_getstringsize(gc, font, &bounds, -1, "@jtLm,!'^", -1, 0);
    gc->text_losefont(gc, font);

    return IH(bounds.ascent);
}


void r_set_clip_rect(mu_Rect rect) {
    bbox_t box;
    dprintf("r_set_clip_rect(%i,%i + %i,%i)\n", rect.x, rect.y, rect.w, rect.h);
    if (rect.x == 0 &&
        rect.y == 0 &&
        rect.w == 0x1000000 &&
        rect.h == 0x1000000)
    {
        gc->clip_rectangle(gc, NULL); /* Reset if it was a full screen */
    }
    else
    {
        box.x0 = X(rect.x);
        box.y0 = Y(rect.y + rect.h);
        box.x1 = X(rect.x + rect.w);
        box.y1 = Y(rect.y);
        dprintf("  %i,%i - %i,%i\n", box.x0, box.y0, box.x1, box.y1);
        gc->clip_rectangle(gc, &box);
    }
}


void r_clear(mu_Color clr) {
    dprintf("r_clear(R%i, G%i, B%i)\n", clr.r, clr.g, clr.b);
    gc->rectangle_fill(gc, COLOUR_RGB(clr.r, clr.g, clr.b),
                       0, 0,
                       screen.width,
                       screen.height);
}


void r_present(void) {
    dprintf("r_present()\n");
    _swix(OS_Byte, _INR(0, 1), 112, bank);
    bank = 3-bank;
    _swix(OS_Byte, _INR(0, 1), 113, bank);
}
